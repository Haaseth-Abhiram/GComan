VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=your_supabase_url_here

# Cloudflare Turnstile (bot protection on contact form).
# Both keys are optional — leaving them blank disables the captcha (form still works).
# Get free keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# - VITE_TURNSTILE_SITE_KEY: public site key, embedded in the bundle (safe to expose)
# - TURNSTILE_SECRET_KEY: server secret. Set in Supabase: supabase secrets set TURNSTILE_SECRET_KEY=...
VITE_TURNSTILE_SITE_KEY=
