# gcoman.com — Apache (Hostinger) configuration
# Translates the Netlify-format public/_redirects + public/_headers into Apache
# rules. Without this file Hostinger's default SPA fallback rewrites every URL
# to /index.html, which prevents Google from ever seeing the per-route HTML
# produced by @prerenderer/rollup-plugin (vite.config.ts).
#
# This file supersedes public/_redirects and public/_headers on Hostinger; those
# files remain in the repo as the source of truth.

Options -Indexes

<IfModule mod_dir.c>
  DirectoryIndex index.html
  # DirectorySlash Off prevents Apache from 301-redirecting /career → /career/.
  # Combined with the prerender rewrite below, /career is served directly from
  # /career/index.html with no URL change.
  DirectorySlash Off
</IfModule>

# ============================================================
# A. URL REWRITES + REDIRECTS
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
# /chemical-supplier bare path -> delivery-locations hub
RewriteRule ^chemical-supplier$ /chemicals [R=301,L]
# retired location page -> Oman hub
RewriteRule ^chemicals/khasab/?$ /chemical-suppliers-oman [R=301,L]
# never-built location / category URLs Google still crawls (GSC 2026-11-09)
RewriteRule ^chemicals/buraimi/?$ /chemical-suppliers-oman [R=301,L]
RewriteRule ^products/food-ingredients/?$ /products/food-beverage [R=301,L]
RewriteRule ^products/paints-coatings/?$ /products/solvents [R=301,L]
RewriteRule ^products/adhesives-sealants/?$ /products/construction [R=301,L]
RewriteRule ^chemicals/barka/?$ /chemical-suppliers-oman [R=301,L]
RewriteRule ^products/agrochemicals/?$ /products/agro [R=301,L]
RewriteRule ^products/specialty-chemicals/?$ /products [R=301,L]
RewriteRule ^products/mining-chemicals/?$ /products [R=301,L]

  RewriteBase /

  # --- A1. Force HTTPS (Cloudflare usually already does this; safety net) ---
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- A2. Strip www ---
  RewriteCond %{HTTP_HOST} ^www\.gcoman\.com$ [NC]
  RewriteRule ^ https://gcoman.com%{REQUEST_URI} [R=301,L]

  # --- A3. /en/* → /* (English is the default; no /en prefix) ---
  RewriteRule ^en/?$ / [R=301,L]
  RewriteRule ^en/(.*)$ /$1 [R=301,L]

  # --- A4. Legacy WordPress 301 redirects (from public/_redirects) ---
  # Product / service pages
  RewriteRule ^service/calcium-carbonate/?$       /products/water-treatment/calcium-carbonate-water [R=301,L]
  RewriteRule ^service/glycols/?$                 /products/glycols [R=301,L]
  RewriteRule ^service/alcohols/?$             /products/alcohols [R=301,L]
  RewriteRule ^service/soap-detergent-chemicals/?$ /products/soap-detergent [R=301,L]
  RewriteRule ^service/solvents/?$                /products/solvents [R=301,L]
  RewriteRule ^service/chlorinated-solvents/?$    /products/chlorinated [R=301,L]
  RewriteRule ^service/construction-chemicals/?$  /products/construction [R=301,L]
  RewriteRule ^service/swimming-1/?$              /products/swimming-pool [R=301,L]
  RewriteRule ^service/lubricants-greases/?$      /products/lubricants [R=301,L]
  RewriteRule ^water-waste-water-treatment-chemicals/?$ /products/water-treatment [R=301,L]
  RewriteRule ^swimming-pool-chemicals/?$         /products/swimming-pool [R=301,L]
  RewriteRule ^lubricants-greases/?$              /products/lubricants [R=301,L]
  RewriteRule ^oilfield-refinery/?$               /products/oilfield [R=301,L]
  RewriteRule ^glycols/?$                         /products/glycols [R=301,L]
  RewriteRule ^product/food-beverages/?$          /products/food-beverage [R=301,L]
  RewriteRule ^products-services/?$               /products [R=301,L]

  # Support & contact
  RewriteRule ^sales-and-comprehensive-support/?$ /contact [R=301,L]
  RewriteRule ^service/general-inquiry/?$         /contact [R=301,L]
  RewriteRule ^technical-support/?$               /contact [R=301,L]

  # Company & team
  RewriteRule ^company/?$                         /about [R=301,L]
  RewriteRule ^our-team/?$                        /about [R=301,L]
  RewriteRule ^partners/?$                        /about [R=301,L]
  RewriteRule ^team-member/james-logan/?$         /about [R=301,L]
  RewriteRule ^team-member/michal-wincent/?$      /about [R=301,L]
  RewriteRule ^team-member/john-tyler/?$          /about [R=301,L]

  # Date-based blog URLs
  RewriteRule ^2021/03/09/the-story-of-a-silk-lends-cotton-like-comfort/?$ /blog [R=301,L]
  RewriteRule ^2021/02/28/laundry-chemical/?$                              /blog [R=301,L]
  RewriteRule ^2021/02/15/textilegence-magazine-digital-platform/?$        /blog [R=301,L]
  RewriteRule ^2021/02/11/contactless-payments-time-has-come/?$            /blog [R=301,L]
  RewriteRule ^whats-new/?$                                                /blog [R=301,L]
  RewriteRule ^2025/10/15/nonwovens-industry-magazine/?$                   /blog [R=301,L]

  # WordPress categories
  RewriteRule ^category/fashion-retail/?$         /industries [R=301,L]
  RewriteRule ^category/news-analysis/?$          /blog [R=301,L]
  RewriteRule ^category/industry-insight/?$       /blog [R=301,L]
  RewriteRule ^category/uncategorized/?$          /blog [R=301,L]
  RewriteRule ^category/lab-equipment/?$          /products/lab-chemicals [R=301,L]

  # WordPress authors / tags
  RewriteRule ^author/samplework1/?$              /blog [R=301,L]
  RewriteRule ^tag/silk/?$                        /blog [R=301,L]
  RewriteRule ^tag/cotton/?$                      /blog [R=301,L]

  # Industries
  RewriteRule ^food-beverages/?$                  /industries [R=301,L]
  RewriteRule ^industries-2/?$                    /industries [R=301,L]
  RewriteRule ^pharmaceutical/?$                  /industries [R=301,L]
  RewriteRule ^manufacturing/?$                   /industries [R=301,L]

  # Careers
  RewriteRule ^jobs/sales-manager/?$              /career [R=301,L]
  RewriteRule ^service-openings/?$                /career [R=301,L]

  # Page slug renames
  RewriteRule ^privacy-policy/?$                  /privacy [R=301,L]
  RewriteRule ^terms-conditions/?$                /terms [R=301,L]
  RewriteRule ^our-values/?$                      /about [R=301,L]
  RewriteRule ^why-choose-us/?$                   /about [R=301,L]
  RewriteRule ^blog-news/?$                       /blog [R=301,L]
  RewriteRule ^what-we-supply-2/?$                /products [R=301,L]

  # Malformed URLs (domain in path)
  RewriteRule ^gcoman\.com/ethanolamines/?$       /products/ethanolamines [R=301,L]
  RewriteRule ^gcoman\.com/blog/?$                /blog [R=301,L]

  # Additional service pages
  RewriteRule ^service/swimming/?$                /products/swimming-pool [R=301,L]
  RewriteRule ^service/laboratories/?$            /products/lab-chemicals [R=301,L]
  RewriteRule ^service/construction/?$            /products/construction [R=301,L]
  RewriteRule ^service/inorganic-chemicals/?$     /products/inorganic [R=301,L]
  RewriteRule ^service/container/?$               /products [R=301,L]
  RewriteRule ^service/food-beverage/?$           /industries [R=301,L]
  RewriteRule ^service/personal-care/?$           /industries [R=301,L]
  RewriteRule ^service/water-treatment-2/?$       /products/water-treatment [R=301,L]
  RewriteRule ^service/automotive-2/?$            /industries [R=301,L]
  RewriteRule ^service/lubricants-greases-1/?$    /products/lubricants [R=301,L]
  RewriteRule ^service/air-chemical/?$            /products [R=301,L]
  RewriteRule ^service/services/oxide/?$          /products [R=301,L]
  RewriteRule ^service/ethanolamines/?$           /products/ethanolamines [R=301,L]
  RewriteRule ^service/pharmaceutical/?$          /industries [R=301,L]
  RewriteRule ^service/agriculture/?$             /industries [R=301,L]
  RewriteRule ^service/construction-1/?$          /products/construction [R=301,L]
  RewriteRule ^service/oil-gas-1/?$               /products/oilfield [R=301,L]
  RewriteRule ^service/water-treatment/?$         /products/water-treatment [R=301,L]

  # Service categories
  RewriteRule ^service-category/chlorinated-solvents/?$   /products/chlorinated [R=301,L]
  RewriteRule ^service-category/oilgas/?$                 /products/oilfield [R=301,L]
  RewriteRule ^service-category/lab-equipment/?$          /products/lab-equipment [R=301,L]
  RewriteRule ^service-category/soap-detergent-chemicals/?$ /products/soap-detergent [R=301,L]

  # Misc product/industry slugs
  RewriteRule ^alcohols/?$                        /products/alcohols [R=301,L]
  RewriteRule ^refinery/?$                        /products/oilfield [R=301,L]

  # --- A4b. Old product URL redirects ---
  # Previous site had a different category structure (acids, alkalis, salts, oxidizers).
  # These 301s fix Soft 404s that Google reports for the old URLs.

  # Old /products/acids/* → new equivalents
  RewriteRule ^products/acids/citric-acid/?$             /products/food-beverage/citric-acid-anhydrous-food [R=301,L]
  RewriteRule ^products/acids/acetic-acid/?$             /products/oilfield/acetic-acid [R=301,L]
  # Dead addresses still shown by Google (GSC, 2026-10-26)
  RewriteRule ^products/agro/agro-products/?$             /products/agro [R=301,L]
  RewriteRule ^products/base-chemicals/?$             /products [R=301,L]
  RewriteRule ^products/industrial-gases/?$             /products [R=301,L]
  RewriteRule ^products/beverage/?$             /products/food-beverage [R=301,L]
  RewriteRule ^products/copper-sulphate-liquid/?$             /products/water-treatment/copper-sulphate-liquid [R=301,L]
  RewriteRule ^products/water-treatment/copper-sulfate-liquid/?$             /products/water-treatment/copper-sulphate-liquid [R=301,L]
  RewriteRule ^products/conrosion-inhibitor/corrosion-inhibitor-closed-system/?$             /products/corrosion-inhibitor/corrosion-inhibitor-closed-system [R=301,L]
  RewriteRule ^products/acids/nitric-acid/?$             /products/lab-chemicals/nitric-acid-lab [R=301,L]
  RewriteRule ^products/acids/phosphoric-acid/?$         /products/lab-chemicals/phosphoric-acid-lab [R=301,L]
  RewriteRule ^products/acids/hydrochloric-acid/?$       /products/lab-chemicals/hydrochloric-acid-lab [R=301,L]
  RewriteRule ^products/acids/sulfuric-acid/?$           /products/lab-chemicals/sulfuric-acid-lab [R=301,L]
  RewriteRule ^products/acids/?$                         /products [R=301,L]
  RewriteRule ^products/acids/(.+)$                      /products [R=301,L]

  # Old /products/alkalis/* → new equivalents
  RewriteRule ^products/alkalis/caustic-soda/?$          /products/water-treatment/caustic-soda-flakes [R=301,L]
  RewriteRule ^products/alkalis/caustic-potash/?$        /products/water-treatment/potassium-hydroxide-water [R=301,L]
  RewriteRule ^products/alkalis/sodium-carbonate/?$      /products/water-treatment/soda-ash-water [R=301,L]
  RewriteRule ^products/alkalis/ammonia-solution/?$      /products/lab-chemicals/ammonia-solution-lab [R=301,L]
  RewriteRule ^products/alkalis/?$                       /products [R=301,L]
  RewriteRule ^products/alkalis/(.+)$                    /products [R=301,L]

  # Old /products/salts/* → new equivalents
  RewriteRule ^products/salts/calcium-chloride/?$        /products/oilfield/calcium-chloride-oil [R=301,L]
  RewriteRule ^products/salts/sodium-chloride/?$         /products/lab-chemicals/sodium-chloride-lab [R=301,L]
  RewriteRule ^products/salts/magnesium-sulphate/?$      /products/lab-chemicals/magnesium-sulfate-lab [R=301,L]
  RewriteRule ^products/salts/sodium-sulphate/?$         /products [R=301,L]
  RewriteRule ^products/salts/?$                         /products [R=301,L]
  RewriteRule ^products/salts/(.+)$                      /products [R=301,L]

  # Old /products/oxidizers/* → new equivalents
  RewriteRule ^products/oxidizers/hydrogen-peroxide/?$   /products/soap-detergent/hydrogen-peroxide-50 [R=301,L]
  RewriteRule ^products/oxidizers/sodium-hypochlorite/?$ /products/water-treatment/sodium-hypochlorite [R=301,L]
  RewriteRule ^products/oxidizers/?$                     /products [R=301,L]
  RewriteRule ^products/oxidizers/(.+)$                  /products [R=301,L]

  # Wrong slug: sitemap previously listed perchloroethylene without -soap-detergent suffix
  RewriteRule ^products/soap-detergent/perchloroethylene/?$  /products/soap-detergent/perchloroethylene-soap-detergent [R=301,L]

  # Old slugs in solvents that moved or were renamed
  RewriteRule ^products/solvents/methanol/?$             /products/alcohols/methanol-industrial [R=301,L]
  RewriteRule ^products/solvents/toluene/?$              /products/lab-chemicals/toluene-lab [R=301,L]
  RewriteRule ^products/solvents/xylene/?$               /products/lab-chemicals/xylene-lab [R=301,L]
  RewriteRule ^products/solvents/mek/?$                  /products/solvents/mek-solvent [R=301,L]
  RewriteRule ^products/solvents/acetone/?$              /products/lab-chemicals/acetone-lab [R=301,L]

  # Old glycol slugs that were renamed
  RewriteRule ^products/glycols/mono-ethylene-glycol/?$  /products/glycols/meg-ethylene-glycol [R=301,L]
  RewriteRule ^products/glycols/monoethylene-glycol/?$   /products/glycols/meg-ethylene-glycol [R=301,L]
  RewriteRule ^products/glycols/diethylene-glycol/?$     /products/water-treatment/deg-water [R=301,L]
  RewriteRule ^products/glycols/meg/?$                   /products/glycols/meg-ethylene-glycol [R=301,L]
  RewriteRule ^products/glycols/deg/?$                   /products/water-treatment/deg-water [R=301,L]

  # Old alcohol slugs that were renamed (e.g. ethanol → ethanol-industrial)
  RewriteRule ^products/alcohols/ethanol/?$              /products/alcohols/ethanol-industrial [R=301,L]
  RewriteRule ^products/alcohols/isopropanol/?$          /products/alcohols/isopropanol-industrial [R=301,L]
  RewriteRule ^products/alcohols/methanol/?$             /products/alcohols/methanol-industrial [R=301,L]
  RewriteRule ^products/alcohols/butanol/?$              /products/alcohols/butanol-industrial [R=301,L]

  # Old top-level category pages that no longer exist
  RewriteRule ^products/oil-gas/?$                       /products/oilfield [R=301,L]
  RewriteRule ^products/cleaning-products/?$             /products/tank-cleaners [R=301,L]

  # --- A4c. WordPress-era prefix catch-alls (specific rules above win first) ---
  RewriteRule ^2021/.*$                                  /blog [R=301,L]
  RewriteRule ^2025/.*$                                  /blog [R=301,L]
  RewriteRule ^category/.*$                              /blog [R=301,L]
  RewriteRule ^tag/.*$                                   /blog [R=301,L]
  RewriteRule ^author/.*$                                /blog [R=301,L]
  RewriteRule ^team-member/.*$                           /about [R=301,L]

  # --- A5. Trailing-slash normalisation (no slash is canonical) ---
  # Skip if the path is the root or maps to an existing directory we want to
  # serve (handled by A6 below).
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # --- A5b. Serve precompressed assets (vite-plugin-compression emits .br/.gz) ---
  # Browsers advertising brotli get file.br; gzip fans get file.gz; the
  # E=no-gzip flag stops mod_deflate double-compressing. Headers set in B.
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)$ $1.br [L,E=no-gzip:1]
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)$ $1.gz [L,E=no-gzip:1]

  # --- A6. Serve prerendered HTML, fall back to SPA shell ---
  # 1. Pass through real files unchanged (sitemap.xml, robots.txt, /assets/*)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. If <path>/index.html exists (prerendered route), serve it without
  #    changing the URL.
  # %{REQUEST_FILENAME} is the full filesystem path (e.g. /home/user/public_html/career).
  # Appending /index.html is more reliable than %{DOCUMENT_ROOT}/$1/index.html on
  # shared hosting where DOCUMENT_ROOT may not be set in .htaccess context.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # 3. Return 404 for <path>/index.html subrequests when the prerendered file
  #    doesn't exist. The Cloudflare Worker (cloudflare-worker.js) fetches
  #    <path>/index.html to check for prerendered content; without this rule
  #    Apache falls through to the SPA shell with a 200, and the Worker
  #    mistakes it for the prerendered page, serving homepage HTML for every
  #    route. With a 404 the Worker correctly falls back to the SPA shell
  #    via its own final fetch(request) call.
  RewriteCond %{REQUEST_URI} /index\.html$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # 4. SPA fallback for genuinely unknown routes — React Router handles 404 UI.
  RewriteRule ^ /index.html [L]
</IfModule>

# ============================================================
# B. RESPONSE HEADERS (replaces public/_headers)
# ============================================================
<IfModule mod_headers.c>
  # Long-lived static assets (Vite outputs hashed filenames under /assets/*)
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "sitemap\.xml$">
    Header set Cache-Control "public, max-age=86400"
    Header set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
  # HTML — short cache, must revalidate so deploys propagate fast
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Security headers — applied to all responses
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://salesiq.zohopublic.com https://js.zohocdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://salesiq.zohopublic.com https://*.zoho.com https://wa.me; frame-src 'self' https://www.google.com https://maps.google.com https://wa.me;"
</IfModule>

# Precompressed asset headers (pairs with A5b). ForceType restores the real
# MIME type that the .br/.gz extension would otherwise mask.
<IfModule mod_headers.c>
  <FilesMatch "\.js\.(br|gz)$">
    ForceType text/javascript
  </FilesMatch>
  <FilesMatch "\.css\.(br|gz)$">
    ForceType text/css
  </FilesMatch>
  <FilesMatch "\.svg\.(br|gz)$">
    ForceType image/svg+xml
  </FilesMatch>
  <FilesMatch "\.html\.(br|gz)$">
    ForceType text/html
  </FilesMatch>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# ============================================================
# C. MIME TYPES
# ============================================================
<IfModule mod_mime.c>
  AddType application/xml          .xml
  AddType image/svg+xml            .svg
  AddType image/webp               .webp
  AddType image/avif               .avif
  AddType font/woff2               .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ============================================================
# D. COMPRESSION (Hostinger usually has this on; safety net)
# ============================================================
<IfModule mod_deflate.c>
  # AddOutputFilterByType is provided by mod_filter, not mod_deflate — the
  # nested guard prevents a whole-site 500 on hosts without it.
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/x-font-ttf
  </IfModule>
</IfModule>
